# Base de dados Postgres (Neon, ligada via Vercel Storage).
# Depois de criares a base de dados na Vercel e correres `vercel env pull .env`,
# estas duas variáveis ficam preenchidas automaticamente — não precisas de as
# escrever à mão.
DATABASE_URL="postgres://usuario:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://usuario:password@host/db?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gera-um-segredo-com: openssl rand -base64 32"

# Dados bancários exibidos no passo de pagamento por transferência
KIPUPU_IBAN="AO06 0000 0000 0000 0000 0000 0"
KIPUPU_BANCO="Nome do Banco"
KIPUPU_TITULAR="Húmuos Grupo, Lda"

# Integração futura: referência Multicaixa Express (EMIS) — preencher quando houver conta de merchant
EMIS_POS_ID=""
EMIS_SUPERVISOR_CARD=""

# WhatsApp Business Cloud API (Meta) — envio automático de credenciais ao
# operador (painel /admin/estacoes/nova) e de acesso ao cliente após
# pagamento confirmado. Ver README ("WhatsApp Business API") para o passo a
# passo de como obter estes dois valores no Meta for Developers. Enquanto
# ficarem vazios, o envio fica em modo simulado (só regista no log).
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
